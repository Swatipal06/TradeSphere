# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<AppName>
JWT_SECRET=your_long_random_secret_here
PORT=3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-frontend.vercel.app,https://your-dashboard.vercel.app

